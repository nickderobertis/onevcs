+/// The stack a branch's own content looks like it has.
+fn inferred_stack(repo: &Path, branch: &str, root: &Ref) -> Result<Option<Target>> {
+    let compared = vcs::base_ref(repo, root);
+    let Some(fork) = git::merge_base(repo, &compared, branch)? else {
+        return Ok(None);
+    };
+    let listed = git::run(
+        &[
+            "rev-list",
+            "--first-parent",
+            &format!("{compared}..{branch}"),
+        ],
+        Some(repo),
+    )?;
+    for candidate in listed.stdout.split_whitespace().skip(1) {
+        if git::known_to_carry_changes(repo, &compared, &fork, candidate)? {
+            return Ok(Some(Target::Stacked {
+                below: root.clone(),
+                root: root.clone(),
+                tip: candidate.to_owned(),
+            }));
+        }
+    }
+    Ok(None)
+}

+/// The stack a branch's own content looks like it has.
+fn inferred_stack(repo: &Path, branch: &str, root: &Ref) -> Result<Option<Stack>> {
+    let compared = vcs::base_ref(repo, root);
+    let Some(fork) = git::merge_base(repo, &compared, branch)? else {
+        return Ok(None);
+    };
+    let listed = git::run(
+        &[
+            "rev-list",
+            "--first-parent",
+            &format!("{compared}..{branch}"),
+        ],
+        Some(repo),
+    )?;
+    for candidate in listed.stdout.split_whitespace().skip(1) {
+        if git::carries_changes(repo, &compared, &fork, candidate)? {
+            return Ok(Some(Stack {
+                tip: candidate.to_owned(),
+                root: root.clone(),
+            }));
+        }
+    }
+    Ok(None)
+}

-verdict=""
-diagnostics=""
-if [ -d "$tmp_root" ] && [ -w "$tmp_root" ]; then
-  verdict="$(mktemp "${tmp_root%/}/lint-llm-diff.XXXXXX" 2>/dev/null || true)"

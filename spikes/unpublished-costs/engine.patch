--- /dev/null
+++ b/src/spike_trace.rs
@@ -0,0 +1,36 @@
+//! Spike spans for `spike-unpublished-costs`: written only where `ONEVCS_SPIKE_TRACE`
+//! names a file, to the same file onevcs's spike trace appends to.
+use std::io::Write;
+use std::sync::OnceLock;
+use std::time::Instant;
+
+fn origin() -> Instant {
+    static AT: OnceLock<Instant> = OnceLock::new();
+    *AT.get_or_init(Instant::now)
+}
+
+pub(crate) struct Span(&'static str, Instant);
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        let Some(path) = std::env::var_os("ONEVCS_SPIKE_TRACE") else {
+            return;
+        };
+        let line = serde_json::json!({
+            "kind": "engine",
+            "name": self.0,
+            "t": std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0.0, |now| now.as_secs_f64() * 1000.0) - self.1.elapsed().as_secs_f64() * 1000.0,
+            "ms": self.1.elapsed().as_secs_f64() * 1000.0,
+            "thread": format!("{:?}", std::thread::current().id()),
+            "identity": "", "branch": "", "extra": null,
+        });
+        if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+            let _ = writeln!(file, "{line}");
+        }
+    }
+}
+
+pub(crate) fn span(name: &'static str) -> Span {
+    origin();
+    Span(name, Instant::now())
+}

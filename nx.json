{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "exportSource": [
          "{workspaceRoot}/crates/onevcs/src/boundary.rs",
          "{workspaceRoot}/crates/onevcs/src/boundary/derive.rs",
          "{workspaceRoot}/crates/onevcs/src/boundary/diagnostics.rs",
          "{workspaceRoot}/crates/onevcs/src/boundary/evidence.rs",
          "{workspaceRoot}/crates/onevcs/src/boundary/generic-words.txt",
          "{workspaceRoot}/crates/onevcs/src/boundary/keys.rs",
          "{workspaceRoot}/crates/onevcs/src/boundary/manifests.rs",
          "{workspaceRoot}/crates/onevcs/src/boundary/phrases.rs",
          "{workspaceRoot}/crates/onevcs/src/boundary/scope.rs",
          "{workspaceRoot}/crates/onevcs/src/boundary/visibility.rs",
          "{workspaceRoot}/crates/onevcs/src/boundary/words.rs",
          "{workspaceRoot}/crates/onevcs/src/checkout_reads.rs",
          "{workspaceRoot}/crates/onevcs/src/error.rs",
          "{workspaceRoot}/crates/onevcs/src/export.rs",
          "{workspaceRoot}/crates/onevcs/src/export/extract.rs",
          "{workspaceRoot}/crates/onevcs/src/export/lfs.rs",
          "{workspaceRoot}/crates/onevcs/src/gh.rs",
          "{workspaceRoot}/crates/onevcs/src/git.rs",
          "{workspaceRoot}/crates/onevcs/src/git/lfs.rs",
          "{workspaceRoot}/crates/onevcs/src/home.rs",
          "{workspaceRoot}/crates/onevcs/src/host.rs",
          "{workspaceRoot}/crates/onevcs/src/ids.rs",
          "{workspaceRoot}/crates/onevcs/src/lfs_pointer.rs",
          "{workspaceRoot}/crates/onevcs/src/lib.rs",
          "{workspaceRoot}/crates/onevcs/src/lock.rs",
          "{workspaceRoot}/crates/onevcs/src/native_objects.rs",
          "{workspaceRoot}/crates/onevcs/src/native_refs.rs",
          "{workspaceRoot}/crates/onevcs/src/policy.rs",
          "{workspaceRoot}/crates/onevcs/src/provenance.rs",
          "{workspaceRoot}/crates/onevcs/src/providers.rs",
          "{workspaceRoot}/crates/onevcs/src/recovery_cache.rs",
          "{workspaceRoot}/crates/onevcs/src/registry.rs",
          "{workspaceRoot}/crates/onevcs/src/remainder.rs",
          "{workspaceRoot}/crates/onevcs/src/rules.rs",
          "{workspaceRoot}/crates/onevcs/src/store.rs",
          "{workspaceRoot}/crates/onevcs/src/testing.rs",
          "{workspaceRoot}/crates/onevcs/src/vcs.rs",
          "{workspaceRoot}/crates/onevcs/src/workspace.rs",
          "{workspaceRoot}/crates/onevcs/src/yaml.rs"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/rustfmt.toml",
      "{workspaceRoot}/clippy.toml",
      "{workspaceRoot}/justfile"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "crateSource": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/crates/**/*",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "sharedGlobals"
    ],
    "wholeWorkspace": ["{workspaceRoot}/**/*"],
    "contractDocs": [
      "{workspaceRoot}/docs/contract.md",
      "{workspaceRoot}/docs/inferred-surface.md"
    ],
    "e2eInputs": ["crateSource", "contractDocs", "{workspaceRoot}/release-targets.toml"],
    "scriptsSuiteInputs": [
      "crateSource",
      "contractDocs",
      "{workspaceRoot}/scripts/**/*",
      // llmlint: ignore-block[changed_behavior_has_e2e] These declarative cache inputs name files the existing push and capture-lane journeys already read; this configuration-only change needs no new behavior test.
      "{workspaceRoot}/.githooks/**/*",
      "{workspaceRoot}/screencomp.toml",
      // llmlint: ignore-end[changed_behavior_has_e2e]
      "{workspaceRoot}/npm/**/*",
      "{workspaceRoot}/.github/**/*",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/release-plz.toml",
      "{workspaceRoot}/project.json",
      "{workspaceRoot}/llmlint.yml",
      "{workspaceRoot}/oneharness.toml",
      "{workspaceRoot}/shots/baseline/**/*",
      "{workspaceRoot}/docs/screenshots/**/*",
      "{workspaceRoot}/pool-maintenance/**/*"
    ],
    "contractInputs": [
      "crateSource",
      "contractDocs",
      "{workspaceRoot}/scripts/**/*",
      "{workspaceRoot}/npm/**/*",
      "{workspaceRoot}/.github/**/*",
      "{workspaceRoot}/release-targets.toml",
      "{workspaceRoot}/README.md",
      "{workspaceRoot}/LICENSE",
      "{workspaceRoot}/CHANGELOG.md",
      "{workspaceRoot}/pyproject.toml"
    ],
    "auditSource": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/crates/onevcs/src/boundary.rs",
      "{workspaceRoot}/crates/onevcs/src/boundary/**/*",
      "{workspaceRoot}/crates/onevcs/Cargo.toml",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "sharedGlobals"
    ],
    "compatSource": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/crates/onevcs/**/*",
      "{workspaceRoot}/Cargo.toml",
      "sharedGlobals"
    ]
  },
  "targetDefaults": {
    "bootstrap": { "cache": false },
    "format": { "cache": false },
    "format-check": { "cache": true, "inputs": ["crateSource"] },
    "lint": { "cache": true, "inputs": ["crateSource"] },
    "doc": { "cache": true, "inputs": ["crateSource"] },
    "test": { "cache": true, "parallelism": false, "inputs": ["crateSource"] },
    "test-quick": { "cache": true, "parallelism": false, "inputs": ["crateSource"] },
    "coverage": { "cache": true, "parallelism": false },
    "check": { "cache": false, "dependsOn": ["format-check", "lint", "test", "doc"] },
    // A project's budgets: `budgets` the deterministic ones, `budgets-host` those
    // labelled `host`, which read the host's clock and are never replayed.
    "budgets": { "cache": false },
    "budgets-host": { "cache": false },
    "lint-llm-diff": {
      "cache": true,
      "inputs": [
        "wholeWorkspace",
        { "env": "LLMLINT_DIFF_BASE_SHA" },
        { "runtime": "llmlint fingerprint" }
      ]
    }
  }
}

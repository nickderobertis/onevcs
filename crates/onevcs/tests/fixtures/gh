#!/usr/bin/env bash
set -euo pipefail

STATE="${ONEVCS_FAKE_GH_STATE:?the substituted host needs a state directory}"
mkdir -p "$STATE"

called_repo=""
repo_given=0
previous=""
for argument in "$@"; do
  if [ "$previous" = "--repo" ]; then
    called_repo="$argument"
    repo_given=1
  fi
  previous="$argument"
done
if [ "$previous" = "--repo" ] || { [ "$repo_given" = 1 ] && ! [[ "$called_repo" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; }; then
  printf 'invalid --repo: expected an owner/name repository slug\n' >&2
  exit 1
fi


# Every call this host is asked to make, one line each, in order. A journey about
# what a *credential* can reach has to assert over this rather than over the
# answer: a stand-in that replies is indistinguishable from one that was allowed
# to be asked, so which endpoints a path touched is readable nowhere else. An
# argument's own newlines are folded into spaces so one call stays one line.
# The call a `lost:` answer performs on the host's side is the same call, logged once.
if [ -z "${ONEVCS_FAKE_GH_ANSWERING:-}" ]; then
  { printf '%s ' "$@" | tr '\n' ' '; printf '\n'; } >>"$STATE/gh-calls.log"
fi

# Whether this call asked to be shown content carrying terminal escape sequences,
# and whether this world's `gh` predates the flag. One that does rejects it here,
# while parsing its arguments, rather than after asking GitHub anything.
allow_escapes=0
for argument in "$@"; do
  [ "$argument" = "--allow-escape-sequences" ] || continue
  allow_escapes=1
done
if [ "$allow_escapes" = "1" ] && [ -f "$STATE/no-escape-flag" ]; then
  printf 'unknown flag: --allow-escape-sequences\n' >&2
  exit 1
fi

# When each call was made, on this host's clock: the same calls `gh-calls.log` lists,
# each after its moment as seconds since the epoch — how a journey shows that nothing
# was asked again before the moment a refusal named.
[ -n "${ONEVCS_FAKE_GH_ANSWERING:-}" ] \
  || { printf '%s ' "$(date +%s.%N)"; printf '%s ' "$@" | tr '\n' ' '; printf '\n'; } >>"$STATE/gh-times.log"

# The REST reads of a change request and of the checks on a commit, which are answered
# below from the same records `gh pr` is: the listing (`pulls?head=`), one change
# request by number (a GET of `pulls/<n>`, which nothing writes to with `--method`), and
# a commit's check runs and commit statuses. Named here because the call ledger, the
# repository a call is answered from, and the dispatch below all turn on it.
rest_call=""
if [ "${1:-}" = "api" ]; then
  rest_path="${2:-}"; rest_path="${rest_path%%\?*}"
  case "$rest_path" in
    repos/*/*/pulls|repos/*/*/commits/*/check-runs|repos/*/*/commits/*/status) rest_call="$rest_path" ;;
    repos/*/*/pulls/*)
      rest_number="${rest_path##*/pulls/}"
      case "$rest_number" in
        ""|*[!0-9]*) ;;
        *)
          rest_call="$rest_path"
          for argument in "$@"; do
            case "$argument" in --method|-X|-f|-F|--field|--raw-field|--input) rest_call="" ;; esac
          done ;;
      esac ;;
  esac
fi

# A request the host does not answer, as `unanswered` says, one rule a line:
# `<text>|<how>`, where `<text>` is matched against the call's arguments as one line and
# `<how>` is `rate-limited:<epoch>` — refused for the rate limit until that moment, as
# GitHub refuses every request until its allowance resets — `rate-limited-for:<n>`, the
# same with the reset `n` seconds after the first refusal, or `server-error:<n>` or
# `unreachable:<n>`: a `502`, or no HTTP response at all, the next `<n>` times (`always`
# for every time) — `lost:<n>` performs the call and then answers it with a `502`,
# `retry-after:<n>` is a rate limit naming both a reset and a later `Retry-After`, and
# `secondary-limited:<n>` the secondary limiter's refusal, which names no reset.
# Each answers the way `gh` reports it: asked `--include`, with the
# status line and GitHub's rate-limit headers ahead of the body; a `gh pr` call, the way
# a GraphQL request fails.
if [ -f "$STATE/unanswered" ] && [ "${2:-}" != "rate_limit" ] \
  && [ -z "${ONEVCS_FAKE_GH_ANSWERING:-}" ]; then
  called="$(printf '%s ' "$@" | tr '\n' ' ')"
  include=false
  for argument in "$@"; do [ "$argument" = "--include" ] && include=true; done
  line=0
  while IFS='|' read -r text how; do
    line=$((line + 1))
    [ -n "$text" ] || continue
    case "$called" in *"$text"*) ;; *) continue ;; esac
    # `rate-limited-for:<n>` is the same refusal with a reset `n` seconds after the
    # first call it refuses, which is how a journey states a reset a few seconds ahead
    # without racing the clock to the call it means.
    case "$how" in
      rate-limited-for:*)
        if [ ! -f "$STATE/unanswered.$line.reset" ]; then
          printf '%s\n' "$(( $(date +%s) + ${how#rate-limited-for:} ))" >"$STATE/unanswered.$line.reset"
        fi
        how="rate-limited:$(cat "$STATE/unanswered.$line.reset")" ;;
    esac
    case "$how" in
      rate-limited:*)
        reset="${how#rate-limited:}"
        [ "$(date +%s)" -lt "$reset" ] || continue
        if [ "${1:-}" = "api" ]; then
          message='API rate limit exceeded for user ID 1. If you reach out to GitHub Support for help, please include the request ID 0000:0000.'
          if [ "$include" = true ]; then
            printf 'HTTP/2.0 403 Forbidden\nContent-Type: application/json; charset=utf-8\nX-Ratelimit-Limit: 5000\nX-Ratelimit-Remaining: 0\nX-Ratelimit-Reset: %s\nX-Ratelimit-Resource: core\nX-Ratelimit-Used: 5000\n\n' "$reset"
          fi
          printf '{"message":"%s","status":"403"}\n' "$message"
          printf 'gh: %s (HTTP 403)\n' "$message" >&2
        else
          printf 'GraphQL: API rate limit already exceeded for user ID 1.\n' >&2
        fi
        exit 1 ;;
      retry-after:*|secondary-limited:*|server-error:*|unreachable:*|lost:*)
        left="${how#*:}"
        counter="$STATE/unanswered.$line.count"
        if [ "$left" != "always" ]; then
          spent="$(cat "$counter" 2>/dev/null || printf 0)"
          [ "$spent" -lt "$left" ] || continue
          printf '%s\n' "$((spent + 1))" >"$counter"
        fi
        case "$how" in
          retry-after:*)
            # A rate limit whose headers name a reset a second away and a `Retry-After`
            # of four — the later of which is when GitHub takes the request again.
            message='API rate limit exceeded for user ID 1.'
            if [ "$include" = true ]; then
              printf 'HTTP/2.0 403 Forbidden\nContent-Type: application/json; charset=utf-8\nRetry-After: 4\nX-Ratelimit-Limit: 5000\nX-Ratelimit-Remaining: 0\nX-Ratelimit-Reset: %s\nX-Ratelimit-Resource: core\n\n' "$(( $(date +%s) + 1 ))"
            fi
            printf '{"message":"%s","status":"403"}\n' "$message"
            printf 'gh: %s (HTTP 403)\n' "$message" >&2 ;;
          secondary-limited:*)
            # The secondary limiter: a refusal for the rate limit that names no reset,
            # while the allowance `rate_limit` reports is not spent.
            message='You have exceeded a secondary rate limit. Please wait a few minutes before you try again.'
            if [ "${1:-}" = "api" ]; then
              [ "$include" = false ] || printf 'HTTP/2.0 403 Forbidden\nContent-Type: application/json; charset=utf-8\n\n'
              printf '{"message":"%s","status":"403"}\n' "$message"
              printf 'gh: %s (HTTP 403)\n' "$message" >&2
            else
              printf 'GraphQL: %s\n' "$message" >&2
            fi ;;
          lost:*)
            # The host did what it was asked, and its answer never arrived: what a `502`
            # in front of a request GitHub had already performed looks like.
            ONEVCS_FAKE_GH_ANSWERING=1 "$0" "$@" >/dev/null 2>&1 || true
            [ "${1:-}" != "api" ] || [ "$include" = false ] || printf 'HTTP/2.0 502 Bad Gateway\nContent-Type: text/html\n\n'
            printf 'non-200 OK status code: 502 Bad Gateway body: ""\n' >&2 ;;
          unreachable:*)
            printf 'error connecting to api.github.com\ncheck your internet connection or https://githubstatus.com\n' >&2 ;;
          *)
            if [ "${1:-}" = "api" ]; then
              [ "$include" = false ] || printf 'HTTP/2.0 502 Bad Gateway\nContent-Type: text/html\n\n'
              printf 'gh: HTTP 502: Bad Gateway (https://api.github.com/%s)\n' "${2:-}" >&2
            else
              printf 'non-200 OK status code: 502 Bad Gateway body: ""\n' >&2
            fi ;;
        esac
        exit 1 ;;
    esac
  done <"$STATE/unanswered"
fi

# The call ledger: every call this host answers, in order, with the change requests it
# names and what GitHub charges for it — one JSON object a line. The calls answered by
# the review host (below) are written there, with the charge that host computes; every
# other call is written here. `gh pr` subcommands are GraphQL on the real host, one point
# each; `gh api` paths and `gh run` are REST requests, one each.
delegated=0
if [ "${1:-}" = "api" ] && [ -z "$rest_call" ]; then
  case "${2:-}" in
    graphql|repos/*/*/pulls/*|repos/*/*/issues/*/comments) delegated=1 ;;
  esac
fi
if [ "$delegated" = "0" ] && [ -z "${ONEVCS_FAKE_GH_ANSWERING:-}" ]; then
  ledger_repo=""; ledger_number=""
  previous=""
  for argument in "$@"; do
    [ "$previous" = "--repo" ] && ledger_repo="$argument"
    previous="$argument"
  done
  if [ "${1:-}" = "pr" ]; then
    case "${2:-}" in
      view|merge|checks|ready|edit) ledger_number="${3:-}" ;;
    esac
  fi
  ledger_changes="[]"
  case "$ledger_number" in
    ""|*[!0-9]*) ;;
    *) [ -n "$ledger_repo" ] && ledger_changes="[\"https://github.com/$ledger_repo/pull/$ledger_number\"]" ;;
  esac
  case "${1:-}" in
    pr|repo) ledger_points=1; ledger_rest=0 ;;
    *) ledger_points=0; ledger_rest=1 ;;
  esac
  printf '{"method":"%s %s","changes":%s,"graphql_points":%s,"rest_requests":%s}\n' \
    "${1:-}" "${2:-}" "$ledger_changes" "$ledger_points" "$ledger_rest" >>"$STATE/ledger.ndjson"
fi

# A world serving several repositories keeps each one's change requests apart, as
# GitHub does: `repos/<owner>/<name>/` is that repository's own state — its origin, its
# change requests, numbered from 1 in each — and a call naming it with `--repo` is
# answered from there. The calls log and the ledger above stay the world's, so one
# journey reads every request every repository was asked. A world with no such
# directory is the one repository it always was.
if [ -n "$rest_call" ] && [ -z "$called_repo" ]; then
  called_repo="${rest_call#repos/}"
  called_repo="${called_repo%%/*}/$(printf '%s' "${rest_call#repos/*/}" | cut -d/ -f1)"
fi
case "$called_repo" in
  */*)
    if [ -d "$STATE/repos/$called_repo" ]; then
      STATE="$STATE/repos/$called_repo"
      [ -n "${ONEVCS_FAKE_GH_ANSWERING:-}" ] \
        || { printf '%s ' "$@" | tr '\n' ' '; printf '\n'; } >>"$STATE/gh-calls.log"
    elif [ -d "$STATE/repos" ]; then
      printf 'invalid --repo: repository %s is not hosted by this world\n' "$called_repo" >&2
      exit 1
    fi
    ;;
esac

ORIGIN="$(cat "$STATE/origin")"
# How many times the checks on a change request's head have been read, this call
# included: each reading asks the check runs on the head once (a lookup of one check's
# job, by `check_name`, is not a reading). Everything below that moves "after the n-th
# reading" counts in this unit, so a journey states the moment it means rather than
# racing a clock for it.
readings_so_far() {
  grep -c '/check-runs?per_page' "$STATE/gh-calls.log" || true
}
# Something that happens on the host at one reading of a rollup, which is how a journey
# states the moment a branch or a base moves while a publication is between two reads:
# `on-reading/<n>` is a script run once, with `ORIGIN` naming the bare origin, by the
# n-th call asking for a rollup — this call counted — before that call answers.
if [ -d "$STATE/on-reading" ] && printf '%s ' "$@" | grep -q '/check-runs?per_page'; then
  at="$STATE/on-reading/$(readings_so_far)"
  if [ -f "$at" ]; then
    ORIGIN="$ORIGIN" bash "$at" >/dev/null 2>&1
    mv "$at" "$at.done"
  fi
fi
# Whether a protection source requires a branch to be up to date with its base before
# it merges — GitHub's `strict`. `up-to-date` names the one source that says so,
# `rulesets` or `classic`; a world that says nothing requires it of no branch. Any
# other value is a world this stand-in cannot answer, so it is refused here rather
# than read as "not required".
UP_TO_DATE="$(cat "$STATE/up-to-date" 2>/dev/null || printf '')"
case "$UP_TO_DATE" in
  ""|rulesets|classic) ;;
  *)
    printf 'fake gh: gh-state/up-to-date names %s, which is neither rulesets nor classic\n' "$UP_TO_DATE" >&2
    exit 1
    ;;
esac
strict_in() {
  if [ "$UP_TO_DATE" = "$1" ]; then
    printf 'true'
  else
    printf 'false'
  fi
}
CHECKS="$STATE/checks.rows"
# A repository's checks move while something is watching them, which is the whole
# premise of watching. This world says so by writing a second rollup and the number
# of *readings of the rollup* after which it takes over — counted off the call log
# above, which already holds this call, so `1` means "from the second reading on".
# Counted in readings rather than in wall-clock time so a journey states the moment
# it means instead of racing for it.
if [ -f "$STATE/checks-flip-after" ] && [ -f "$STATE/checks.rows.next" ]; then
  if [ "$(readings_so_far)" \
       -gt "$(cat "$STATE/checks-flip-after")" ]; then
    CHECKS="$STATE/checks.rows.next"
  fi
fi
# A watch reads a repository through phases — the jobs its aggregate needs running,
# then the gap before the aggregate's own check run appears, then the aggregate — and
# this world says so as `timeline/<n>/`: from the reading of the rollup after the
# n-th on, that directory's `checks.rows`, `runs.rows` and `suites.rows` stand in for
# the ones beside this script's state. Of the phases passed, the latest wins; counted
# in readings for the reason the flip above is.
PHASE=""
if [ -d "$STATE/timeline" ]; then
  readings="$(readings_so_far)"
  for dir in "$STATE"/timeline/*/; do
    n="$(basename "$dir")"
    case "$n" in ""|*[!0-9]*) continue ;; esac
    if [ "$readings" -gt "$n" ]; then
      if [ -z "$PHASE" ] || [ "$n" -gt "$(basename "$PHASE")" ]; then PHASE="${dir%/}"; fi
    fi
  done
  if [ -n "$PHASE" ] && [ -f "$PHASE/checks.rows" ]; then CHECKS="$PHASE/checks.rows"; fi
fi
# The workflow runs and the check suites on a head, one row each — a run as
# `name|status|conclusion`, a suite as `app|status|conclusion|latest_check_runs_count`.
# A world with no `runs.rows` has the one completed run it always had on a head a
# change request is at, and one with no `suites.rows` has no suite.
RUNS="$STATE/runs.rows"
SUITES="$STATE/suites.rows"
if [ -n "$PHASE" ]; then
  if [ -f "$PHASE/runs.rows" ]; then RUNS="$PHASE/runs.rows"; fi
  if [ -f "$PHASE/suites.rows" ]; then SUITES="$PHASE/suites.rows"; fi
fi
# A repository whose workflow skips drafts registers its real run only once the
# change is lifted: `checks.rows.after-ready` takes over once any change request here
# has been made ready for review, which is the moment GitHub fires the workflow.
if [ -f "$STATE/checks.rows.after-ready" ] && ls "$STATE"/ready-* >/dev/null 2>&1; then
  CHECKS="$STATE/checks.rows.after-ready"
fi
# …and the workflow runs it reports on the head once any change request here has been
# lifted, which is a run still going, or one started again, on the same commit.
if [ -f "$STATE/runs.rows.after-ready" ] && ls "$STATE"/ready-* >/dev/null 2>&1; then
  RUNS="$STATE/runs.rows.after-ready"
fi
# When each run started, which is a run's own identity: the rows a lift or a flip
# brings in are runs of their own, so they report a start the rows before them did
# not — which is how GitHub tells a re-run from the run it replaced.
case "$CHECKS" in
  */checks.rows.after-ready) STARTED="2026-09-30T12:02:00Z" ;;
  */checks.rows.next) STARTED="2026-09-30T12:01:00Z" ;;
  *) STARTED="2026-09-30T12:00:00Z" ;;
esac
malformed="$(cat "$STATE/malformed" 2>/dev/null || printf '')"
# A run queued and not started, which GitHub reports with the zero time rather than
# with no start at all.
case "$malformed" in *zero-start) STARTED="0001-01-01T00:00:00Z" ;; esac

# Which commit this host believes a change request is at, which is not necessarily
# where the branch is: GitHub records that when it *processes* a push rather than
# when the push returns, and renders the rollup from that head's checks. A world
# that says nothing here is a host that never noticed, which is the recorded head
# for ever; one that does says so in readings of the rollup, the same unit the
# rollup's own flip above is counted in.
#
# A third argument of `1` asks as the reading about to be made: a reading reads the
# change request's head first and its checks second, and the head it reads is that
# reading's own.
head_seen() {
  local recorded="$1" branch="$2" ahead="${3:-0}"
  if [ -f "$STATE/head-noticed-after" ] \
    && [ "$(( $(readings_so_far) + ahead ))" \
         -gt "$(cat "$STATE/head-noticed-after")" ]; then
    git --git-dir "$ORIGIN" rev-parse "refs/heads/$branch" 2>/dev/null || printf '%s' "$recorded"
    return
  fi
  printf '%s' "$recorded"
}

# Whether this host can merge a change request into its base, as GitHub says it in
# two words: `mergeable` (MERGEABLE, CONFLICTING, or UNKNOWN while it has not computed
# it) and `mergeStateStatus` (CLEAN, DIRTY, ...). A world that says nothing is a change
# that merges cleanly. A base moves under a change on its own clock, which this world
# says the way it says a rollup that moves: `mergeable.next` takes over after the number
# of *readings of the rollup* `mergeable-flip-after` names, so a journey can move the
# checks and the mergeability at the same reading.
mergeability_now() {
  local source="$STATE/mergeable"
  if [ -f "$STATE/mergeable-flip-after" ] && [ -f "$STATE/mergeable.next" ] \
    && [ "$(readings_so_far)" \
         -gt "$(cat "$STATE/mergeable-flip-after")" ]; then
    source="$STATE/mergeable.next"
  fi
  if [ -f "$source" ]; then
    tr -s '[:space:]' ' ' <"$source" | sed 's/ $//'
  else
    printf 'MERGEABLE CLEAN'
  fi
}

# What a credential GitHub will not let read a change request's check runs is told,
# in the two shapes it is told it: the GraphQL rollup names the node it would not
# produce, and the REST endpoints answer 403. Both are refusals, and neither says
# there are no checks.
refused_graphql() {
  printf 'GraphQL: Resource not accessible by personal access token (repository.pullRequest.statusCheckRollup.nodes.0.commit.statusCheckRollup.contexts.nodes.0)\n' >&2
  exit 1
}

# Whether this world's credential may read check runs at all. `actions-only` is the
# fine-grained token the real tier runs under: it reads the Actions API and the
# repository's rulesets, and nothing that resolves a check run.
readable_rollup() {
  case "$malformed" in
    checks-refused|actions-only*|misleading-refusal) return 1 ;;
    *) return 0 ;;
  esac
}

# The rows one head commit's checks are rendered from: its own, where a journey seeded
# checks for that commit, and otherwise the repository's — so a host can carry several
# change requests whose heads stand differently, and a world that says nothing per head
# is the one it always was.
rows_for() {
  if [ -n "${1:-}" ] && [ -f "$STATE/checks/$1.rows" ]; then
    printf '%s' "$STATE/checks/$1.rows"
  else
    printf '%s' "$CHECKS"
  fi
}

# One job's log, addressed by the job's **id** — the id a row has in this world,
# which is what both `gh run view --job` and the Actions API answer to.
#
# The only answer here that is content rather than this host's own words, so the
# only one the escape guard can fire on. It fires on what the content carries, the
# way `gh` does, rather than on having been asked.
job_log() {
  local want="$1" name source
  if [ -f "$STATE/no-logs" ]; then
    printf 'this repository keeps its check logs to itself\n' >&2
    exit 1
  fi
  name="$(awk -F'|' -v want="$want" 'NF && ++row == want { print $1 }' "$CHECKS" 2>/dev/null || printf '')"
  if [ -z "$name" ]; then
    printf 'could not find any jobs with ID %s\n' "$want" >&2
    exit 1
  fi
  source="$STATE/log-$name.txt"
  if [ ! -f "$source" ]; then
    source="$STATE/rendered-log"
    printf 'the host log for check %s\n' "$name" >"$source"
  fi
  if [ -f "$STATE/guards-escapes" ] && [ "$allow_escapes" = "0" ] \
    && LC_ALL=C grep -q "$(printf '\033')" "$source"; then
    printf 'the response contains terminal escape sequences; pass --allow-escape-sequences to output it anyway\n' >&2
    exit 1
  fi
  cat "$source"
}

# A change request's review feedback — its review threads, review summaries and
# conversation comments, and the replies posted to them. Its paged GraphQL read, its
# edits and its thread flags are a model a shell keeps badly, so a journey serves it
# from its own process (`tests/e2e/review_host.rs`) over two directories here: each
# call drops its whole argument vector into `review/requests/` and waits for its
# answer in `review/answers/`. A world serving no review host refuses the call, and a
# host that never answers is given up on rather than waited on for ever.
review_host() {
  local dir="$STATE/review" id waited=0 status
  if [ ! -d "$dir/requests" ]; then
    printf 'fake gh: this world serves no review comments\n' >&2
    exit 1
  fi
  id="$$-$RANDOM$RANDOM"
  printf '%s\0' "$@" >"$dir/requests/.$id"
  mv "$dir/requests/.$id" "$dir/requests/$id"
  until [ -f "$dir/answers/$id.status" ]; do
    waited=$((waited + 1))
    if [ "$waited" -gt 12000 ]; then
      printf 'fake gh: the review host did not answer\n' >&2
      exit 1
    fi
    sleep 0.01
  done
  cat "$dir/answers/$id.out"
  cat "$dir/answers/$id.err" >&2
  status="$(cat "$dir/answers/$id.status")"
  rm -f "$dir/answers/$id.out" "$dir/answers/$id.err" "$dir/answers/$id.status"
  exit "$status"
}

ARGUMENTS=("$@")
command="${1:-}"; shift || true

case "$command" in
  api)
    path="${1:-}"; shift || true
    query=""
    case "$path" in
      *\?*) query="${path#*\?}"; path="${path%%\?*}" ;;
    esac
    if [ "$path" = "user" ]; then
      # Asked `--include`, the user's record as GitHub's REST API answers it; asked for
      # `--jq .login`, the login alone, as `gh` prints it.
      jq_login=0
      for argument in "$@"; do [ "$argument" = "--include" ] && jq_login=2; done
      for argument in "$@"; do [ "$argument" = "--jq" ] && jq_login=1; done
      case "$jq_login" in
        1) printf 'tester\n' ;;
        2) printf 'HTTP/2.0 200 OK\nContent-Type: application/json; charset=utf-8\nX-Ratelimit-Limit: 5000\nX-Ratelimit-Remaining: 4999\nX-Ratelimit-Resource: core\n\n{"login":"tester","id":1,"type":"User"}\n' ;;
        *) printf '{"login":"tester","id":1,"type":"User"}\n' ;;
      esac
      exit 0
    fi
    if [ "$path" = "rate_limit" ]; then
      # What is left of each allowance and when it resets, which GitHub answers without
      # charging it: every allowance a rule in `unanswered` holds spent is spent until
      # that rule's moment, and every other is whole.
      now="$(date +%s)"; spent=0
      if [ -f "$STATE/unanswered" ]; then
        line=0
        while IFS='|' read -r text how; do
          line=$((line + 1))
          case "$how" in
            rate-limited-for:*)
              reset="$(cat "$STATE/unanswered.$line.reset" 2>/dev/null || printf 0)" ;;
            rate-limited:*)
              reset="${how#rate-limited:}" ;;
            *) continue ;;
          esac
          if [ "$reset" -gt "$now" ] && [ "$reset" -gt "$spent" ]; then spent="$reset"; fi
        done <"$STATE/unanswered"
      fi
      if [ "$spent" -gt 0 ]; then remaining=0; reset="$spent"; else remaining=5000; reset=$((now + 3600)); fi
      printf '{"resources":{"core":{"limit":5000,"used":%s,"remaining":%s,"reset":%s},"graphql":{"limit":5000,"used":%s,"remaining":%s,"reset":%s}}}\n' \
        "$((5000 - remaining))" "$remaining" "$reset" "$((5000 - remaining))" "$remaining" "$reset"
      exit 0
    fi
    # The REST reads of a change request and of a commit's checks are answered below,
    # beside `gh pr`'s, from the same records.
    if [ -z "$rest_call" ]; then
    case "$path" in
      graphql|repos/*/*/pulls/*|repos/*/*/issues/*/comments)
        review_host "${ARGUMENTS[@]}" ;;
    esac
    # Everything below is GitHub's REST API: the Actions endpoints and the
    # repository's rulesets, which is what a token that may not resolve a check run
    # is left with. `checks-refused` is the credential that may not read those
    # either, and it declines here the way the API declines.
    if [ "$malformed" = "checks-refused" ]; then
      # Asked `--include`, `gh` prints the refusal's status line and body too.
      for argument in "$@"; do
        if [ "$argument" = "--include" ]; then
          printf 'HTTP/2.0 403 Forbidden\n\n{"message":"Resource not accessible by personal access token","status":"403"}\n'
        fi
      done
      printf 'gh: Resource not accessible by personal access token (HTTP 403)\n' >&2
      exit 1
    fi
    # What is running on a head is two reads, and a credential may be refused either:
    # the check suites need the Checks permission no fine-grained token has, and
    # `activity-refused` is a credential refused both.
    case "$path" in
      */commits/*/check-suites)
        if ! readable_rollup || [ "$malformed" = "suites-refused" ] || [ "$malformed" = "activity-refused" ]; then
          printf 'gh: Resource not accessible by personal access token (HTTP 403)\n' >&2
          exit 1
        fi ;;
      */actions/runs)
        if [ "$malformed" = "activity-refused" ]; then
          printf 'gh: Resource not accessible by personal access token (HTTP 403)\n' >&2
          exit 1
        fi ;;
    esac
    case "$path" in
      repos/*/*/*) ;;
      repos/*/*)
        # A repository's own record, read for its visibility. A world that has said
        # nothing about one is a host this credential cannot read it from, which is a
        # refusal; `refuse` says so explicitly, and `forbidden` is the same refusal as
        # a 403. `rate-limited:<reset epoch>`, `secondary-limited`, `too-many-requests`,
        # `rate-limit-message` (a 403 that says so and sends no quota),
        # `rate-limit-garbled` (one whose quota headers are not numbers), `quota-spent`
        # and `retry-after` (a 403 saying nothing but that header), `quota-odd` (a
        # spent quota whose resource and reset are not ones to print), `server-error`
        # and `unreachable` are a host that did not answer at all. Asked `--include`, it
        # prints the status line and headers ahead of the body, as `gh` does — on a
        # refusal too.
        slug="${path#repos/}"
        include=false
        for argument in "$@"; do
          [ "$argument" = "--include" ] && include=true
        done
        # One response: status line, extra headers (one per line, may be empty), body,
        # and what `gh` itself says on stderr when the status is not a success.
        respond() {
          if [ "$include" = true ]; then
            printf 'HTTP/2.0 %s\nContent-Type: application/json; charset=utf-8\n' "$1"
            [ -n "$2" ] && printf '%s\n' "$2"
            printf '\n'
          fi
          printf '%s\n' "$3"
          if [ -n "${4:-}" ]; then
            printf 'gh: %s\n' "$4" >&2
            exit 1
          fi
          exit 0
        }
        quota='X-Ratelimit-Limit: 5000
X-Ratelimit-Remaining: 4999
X-Ratelimit-Resource: core'
        not_found() {
          respond '404 Not Found' "$quota" '{"message":"Not Found","status":"404"}' 'Not Found (HTTP 404)'
        }
        answer="$STATE/visibility/$slug"
        [ -f "$answer" ] || not_found
        visibility="$(cat "$answer")"
        case "$visibility" in
          refuse) not_found ;;
          forbidden)
            respond '403 Forbidden' "$quota" \
              '{"message":"Resource not accessible by personal access token","status":"403"}' \
              'Resource not accessible by personal access token (HTTP 403)' ;;
          rate-limited:*)
            message='API rate limit exceeded for user ID 1. If you reach out to GitHub Support for help, please include the request ID 0000:0000.'
            respond '403 Forbidden' "X-Ratelimit-Limit: 5000
X-Ratelimit-Remaining: 0
X-Ratelimit-Reset: ${visibility#rate-limited:}
X-Ratelimit-Resource: core
X-Ratelimit-Used: 5000" "{\"message\":\"$message\",\"status\":\"403\"}" "$message (HTTP 403)" ;;
          secondary-limited)
            message='You have exceeded a secondary rate limit. Please wait a few minutes before you try again.'
            respond '403 Forbidden' "Retry-After: 60
$quota" "{\"message\":\"$message\",\"status\":\"403\"}" "$message (HTTP 403)" ;;
          too-many-requests)
            respond '429 Too Many Requests' 'Retry-After: 30' \
              '{"message":"Too Many Requests","status":"429"}' 'Too Many Requests (HTTP 429)' ;;
          quota-spent)
            respond '403 Forbidden' 'X-Ratelimit-Limit: 15000
X-Ratelimit-Remaining: 0
X-Ratelimit-Reset: 1792285566
X-Ratelimit-Resource: core' '{"message":"Forbidden","status":"403"}' 'Forbidden (HTTP 403)' ;;
          quota-odd)
            respond '403 Forbidden' 'X-Ratelimit-Limit: 5000
X-Ratelimit-Remaining: 0
X-Ratelimit-Reset: 99999999999999999
X-Ratelimit-Resource: Core Quota' '{"message":"Forbidden","status":"403"}' 'Forbidden (HTTP 403)' ;;
          retry-after)
            respond '403 Forbidden' "Retry-After: 120
$quota" '{"message":"Forbidden","status":"403"}' 'Forbidden (HTTP 403)' ;;
          rate-limit-message)
            message='API rate limit exceeded for installation ID 2.'
            respond '403 Forbidden' '' "{\"message\":\"$message\",\"status\":\"403\"}" "$message (HTTP 403)" ;;
          rate-limit-garbled)
            message='API rate limit exceeded for user ID 1.'
            respond '403 Forbidden' 'X-Ratelimit-Limit: 5000 per hour
X-Ratelimit-Remaining: none
X-Ratelimit-Reset: soon
X-Ratelimit-Resource: Core Quota
Retry-After: Wed, 21 Oct 2026 07:28:00 GMT' "{\"message\":\"$message\",\"status\":\"403\"}" "$message (HTTP 403)" ;;
          server-error)
            # `gh` names the URL it asked when the host gave no message of its own.
            respond '502 Bad Gateway' '' '' "HTTP 502: Bad Gateway (https://api.github.com/repos/$slug)" ;;
          unreachable)
            printf 'error connecting to api.github.com\ncheck your internet connection or https://githubstatus.com\n' >&2
            exit 1 ;;
        esac
        private=false
        [ "$visibility" = "public" ] || private=true
        respond '200 OK' "$quota" "{\"full_name\":\"$slug\",\"private\":$private,\"visibility\":\"$visibility\"}" ;;
    esac
    case "$path" in
      */actions/runs)
        head_sha="${query#*head_sha=}"; head_sha="${head_sha%%&*}"
        runs=0
        for record in "$STATE"/pr-*.env; do
          [ -e "$record" ] || continue
          # Through the same lag the change request's own head is reported through:
          # GitHub attaches a workflow run to a commit when it processes the push,
          # so a run on the head this host has not noticed yet is a run it does not
          # report either.
          if ( . "$record"; [ "$(head_seen "$PR_HEAD_SHA" "$PR_HEAD")" = "$head_sha" ] ); then runs=1; fi
        done
        if [ "$runs" = "0" ]; then
          # No workflow has run on that commit, which is what a commit nothing was
          # opened against reports.
          printf '{"total_count":0,"workflow_runs":[]}\n'
          exit 0
        fi
        # A run whose own record says it ran against something that is not a commit
        # hash. The commit a job's check is attached to is taken off this field
        # rather than off the query, so this is the one place that answer can arrive
        # malformed on the Actions path.
        if [ "$malformed" = "actions-only-run-head-not-a-commit" ]; then
          head_sha="the tip of feature/x"
        fi
        # GitHub's "List workflow runs for a repository": each run names its workflow,
        # the commit it ran against, and where it is — `queued`, `in_progress`,
        # `completed` and the rest — with a conclusion once it has one.
        slug="${path#repos/}"; slug="${slug%%/actions/*}"
        rows=""; separator=""; id=0
        if [ -f "$RUNS" ]; then
          while IFS='|' read -r name status conclusion; do
            [ -n "$name" ] || continue
            id=$((id + 1))
            if [ -n "$conclusion" ]; then entry="\"$conclusion\""; else entry=null; fi
            rows="$rows$separator{\"id\":$id,\"name\":\"$name\",\"head_branch\":\"feature\",\"head_sha\":\"$head_sha\",\"event\":\"pull_request\",\"status\":\"$status\",\"conclusion\":$entry,\"html_url\":\"https://github.com/$slug/actions/runs/$id\"}"
            separator=","
          done <"$RUNS"
        else
          id=1
          rows="{\"id\":1,\"name\":\"ci\",\"head_branch\":\"feature\",\"head_sha\":\"$head_sha\",\"event\":\"pull_request\",\"status\":\"completed\",\"conclusion\":\"success\",\"html_url\":\"https://github.com/$slug/actions/runs/1\"}"
        fi
        printf '{"total_count":%s,"workflow_runs":[%s]}\n' "$id" "$rows"
        exit 0 ;;
      */commits/*/check-suites)
        # GitHub's "List check suites for a Git reference": one suite per app that has
        # posted — or been asked to — about the commit, with where it is and how many
        # check runs it holds. Only for a head a change request here is at, as the
        # workflow runs are.
        head_sha="${path%/check-suites}"; head_sha="${head_sha##*/}"
        on_a_head=0
        for record in "$STATE"/pr-*.env; do
          [ -e "$record" ] || continue
          if ( . "$record"; [ "$(head_seen "$PR_HEAD_SHA" "$PR_HEAD")" = "$head_sha" ] ); then on_a_head=1; fi
        done
        rows=""; separator=""; id=0
        if [ "$on_a_head" = "1" ] && [ -f "$SUITES" ]; then
          while IFS='|' read -r app status conclusion count; do
            [ -n "$app" ] || continue
            id=$((id + 1))
            if [ -n "$conclusion" ]; then entry="\"$conclusion\""; else entry=null; fi
            rows="$rows$separator{\"id\":$id,\"head_branch\":\"feature\",\"head_sha\":\"$head_sha\",\"status\":\"$status\",\"conclusion\":$entry,\"app\":{\"id\":$id,\"slug\":\"$app\",\"name\":\"$app\"},\"pull_requests\":[],\"latest_check_runs_count\":${count:-0}}"
            separator=","
          done <"$SUITES"
        fi
        printf '{"total_count":%s,"check_suites":[%s]}\n' "$id" "$rows"
        exit 0 ;;
      */actions/runs/*/jobs)
        # Every job is the first run's: a world listing several runs lists its jobs once.
        run="${path%/jobs}"; run="${run##*/}"
        if [ "$run" != "1" ]; then
          printf '{"total_count":0,"jobs":[]}\n'
          exit 0
        fi
        # The same rows the rollup is rendered from, as the jobs of that one run —
        # so what this host reports through either source and what it acts on when
        # asked to merge cannot disagree. A job's id is its row, which is the id
        # `gh run view --job` answers to as well, and `html_url` is the same address
        # the rollup reports that check's `detailsUrl` as: one check, one place on
        # the host, whichever source a credential can read it from.
        slug="${path#repos/}"; slug="${slug%%/actions/*}"
        rows=""; separator=""; row=0; entry=""
        while IFS='|' read -r name status conclusion required kind; do
          [ -n "$name" ] || continue
          row=$((row + 1))
          # A commit status is posted by an integration, not run as a job: Actions
          # never lists one.
          [ "$kind" != "status" ] || continue
          if [ -n "$conclusion" ]; then entry="\"$conclusion\""; else entry=null; fi
          # A job still running has no completion, which the Actions API says as null.
          if [ "$status" = "completed" ]; then done_at="\"${STARTED%:00Z}:30Z\""; else done_at=null; fi
          rows="$rows$separator{\"id\":$row,\"name\":\"$name\",\"status\":\"$status\",\"conclusion\":$entry,\"html_url\":\"https://github.com/$slug/actions/runs/1/job/$row\",\"started_at\":\"$STARTED\",\"completed_at\":$done_at}"
          separator=","
        done <"$CHECKS" 2>/dev/null || true
        total="$row"
        # A page that held entries back. The listing says how many there are, and a
        # build that read the short list as the whole answer would wait for a check
        # it was never shown.
        if [ "$malformed" = "actions-only-truncated" ]; then total=$((row + 1)); fi
        printf '{"total_count":%s,"jobs":[%s]}\n' "$total" "$rows"
        exit 0 ;;
      */actions/jobs/*/logs)
        job="${path%/logs}"; job="${job##*/}"
        job_log "$job"
        exit 0 ;;
      */branches/*/protection/required_status_checks)
        # Classic branch protection, the second way GitHub protects a branch and the
        # one a credential without administration rights is refused. Unset, the
        # branch has none, which GitHub says as a 404 that is an answer.
        if [ "$malformed" = "classic-protection-refused" ]; then
          printf 'gh: Resource not accessible by personal access token (HTTP 403)\n' >&2
          exit 1
        fi
        if [ ! -f "$STATE/classic-protection" ]; then
          printf 'gh: Branch not protected (HTTP 404)\n' >&2
          exit 1
        fi
        contexts=""; separator=""
        while IFS= read -r context; do
          [ -n "$context" ] || continue
          contexts="$contexts$separator\"$context\""
          separator=","
        done <"$STATE/classic-protection"
        printf '{"strict":%s,"contexts":[%s],"checks":[]}\n' "$(strict_in classic)" "$contexts"
        exit 0 ;;
      */rules/branches/*)
        # A base whose requirement a journey stated names exactly that, which may be
        # nothing at all; every other base requires what the repository's rows mark.
        ruled="${path##*/rules/branches/}"
        if [ -f "$STATE/required/$ruled" ]; then
          contexts=""; separator=""
          while IFS= read -r context; do
            [ -n "$context" ] || continue
            contexts="$contexts$separator{\"context\":\"$context\",\"integration_id\":15368}"
            separator=","
          done <"$STATE/required/$ruled"
          if [ -z "$contexts" ]; then
            printf '[]\n'
            exit 0
          fi
          printf '[{"type":"required_status_checks","ruleset_source_type":"Repository","parameters":{"strict_required_status_checks_policy":%s,"required_status_checks":[%s]}}]\n' "$(strict_in rulesets)" "$contexts"
          exit 0
        fi
        # A host that will not say which of its checks block the merge: a ruleset that
        # says it requires status checks and names none of them.
        if [ -f "$STATE/partial-checks" ]; then
          printf '[{"type":"required_status_checks","parameters":{}}]\n'
          exit 0
        fi
        case "$malformed" in
          actions-only-rules-not-a-list)
            printf '{"rules":[]}\n'
            exit 0 ;;
          actions-only-rules-unsaid)
            # A ruleset that says it requires status checks and will not say which.
            printf '[{"type":"required_status_checks","parameters":{}}]\n'
            exit 0 ;;
        esac
        contexts=""; separator=""
        while IFS='|' read -r name status conclusion required kind; do
          [ -n "$name" ] || continue
          [ "$required" = "true" ] || continue
          contexts="$contexts$separator{\"context\":\"$name\",\"integration_id\":15368}"
          separator=","
        done <"$CHECKS" 2>/dev/null || true
        if [ -z "$contexts" ] && [ "$(strict_in rulesets)" = "false" ]; then
          # A repository with no ruleset requiring anything, which is what the
          # scratch repository the real tier runs against answers.
          printf '[]\n'
          exit 0
        fi
        printf '[{"type":"required_status_checks","ruleset_source_type":"Repository","parameters":{"strict_required_status_checks_policy":%s,"required_status_checks":[%s]}}]\n' "$(strict_in rulesets)" "$contexts"
        exit 0 ;;
    esac
    printf 'fake gh: unsupported api path %s\n' "$path" >&2
    exit 1
    fi
    ;;
  run)
    # `gh run view --log --job` addresses a job by its **id**, never by a check's
    # name, so this answers to the id `pr checks` reported for that row and to
    # nothing else — a caller that passed a name would fail here as it does against
    # the real host.
    job=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --job) job="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    job_log "$job"
    exit 0
    ;;
  repo)
    # `gh repo view --json autoMergeAllowed`: whether the repository lets a change be
    # armed to merge itself once its checks pass. The same world file that makes the
    # arming itself refused says no here, so the two answers cannot disagree.
    if [ "${1:-}" != "view" ]; then
      printf 'fake gh: unsupported repo subcommand %s\n' "${1:-}" >&2
      exit 1
    fi
    if [ -f "$STATE/refuse-repo-view" ]; then
      printf 'GraphQL: Resource not accessible by personal access token (repository)\n' >&2
      exit 1
    fi
    allowed=true
    [ ! -f "$STATE/auto-merge-unavailable" ] || allowed=false
    printf '{"autoMergeAllowed":%s}\n' "$allowed"
    exit 0
    ;;
  pr) ;;
  *)
    printf 'fake gh: unsupported command %s\n' "$command" >&2
    exit 1
    ;;
esac

subcommand="${1:-}"; shift || true
# A REST read answered from the change requests' records below, rather than a `gh pr`
# subcommand.
[ -z "$rest_call" ] || subcommand=rest
number=""
case "$subcommand" in
  view|merge|checks|ready|edit)
    number="${1:-}"; shift || true
    # The number is what selects the per-change state this subcommand reads, so it
    # is argv reaching a path. Refuse anything but digits here, at the one place the
    # value arrives, rather than letting it name a file further down.
    case "$number" in
      ""|*[!0-9]*)
        printf 'fake gh: pr %s addresses a change by its number, not %s\n' "$subcommand" "$number" >&2
        exit 1 ;;
    esac
    ;;
esac

repo=""; head=""; base=""; title=""; body=""; auto=0; json_fields=""; only_required=0
draft=0; body_file=""; titled=0
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo="${2:-}"; shift 2 ;;
    --head) head="${2:-}"; shift 2 ;;
    --base) base="${2:-}"; shift 2 ;;
    --title) title="${2:-}"; titled=1; shift 2 ;;
    --body) body="${2:-}"; shift 2 ;;
    --body-file) body_file="${2:-}"; shift 2 ;;
    --json) json_fields="${2:-}"; shift 2 ;;
    --state) shift 2 ;;
    --auto) auto=1; shift ;;
    --draft) draft=1; shift ;;
    --required) only_required=1; shift ;;
    *) shift ;;
  esac
done

# The rollup and the merge decision are rendered from the same rows, so what the
# host reports and what it acts on cannot disagree.
#
# It carries no `isRequired`, because `gh pr view` carries none: its rollup says
# what a check is called, where it is, and how it ended, and nothing about whether
# it blocks anything. Emitting one here is what let this crate read a field the
# real host has never returned. Whether a check blocks is answered by
# `pr checks --required`, below.
rollup() {
  printf '['
  local separator="" name status conclusion required kind entry completed state row=0 rows="${1:-$CHECKS}"
  while IFS='|' read -r name status conclusion required kind; do
    [ -n "$name" ] || continue
    row=$((row + 1))
    # A row whose fifth field is `status` is a commit status an integration posted,
    # which GitHub's rollup reports as a `StatusContext`: named by its `context`, with
    # one `state` — PENDING until it has a verdict, then SUCCESS, FAILURE or ERROR —
    # and the address it was posted with.
    if [ "$kind" = "status" ]; then
      if [ "$status" = "completed" ]; then state="$(printf '%s' "$conclusion" | tr '[:lower:]' '[:upper:]')"; else state="PENDING"; fi
      printf '%s{"__typename":"StatusContext","context":"%s","state":"%s","targetUrl":"https://ci.example.com/%s/%s","startedAt":"%s"}' \
        "$separator" "$name" "$state" "$repo" "$row" "$STARTED"
      separator=","
      continue
    fi
    if [ -n "$conclusion" ]; then entry="\"$conclusion\""; else entry=null; fi
    # `detailsUrl` is where a check run says it is, and it is the same address
    # `pr checks` reports as that row's `link` — one check, one place on the host,
    # whichever call asked about it.
    # A run that has completed says when, as GitHub's rollup does; one still going
    # carries the zero time, which is how GitHub spells "not yet".
    if [ "$status" = "completed" ]; then completed="${STARTED%:00Z}:30Z"; else completed="0001-01-01T00:00:00Z"; fi
    printf '%s{"__typename":"CheckRun","name":"%s","status":"%s","conclusion":%s,"detailsUrl":"https://github.com/%s/actions/runs/1/job/%s","startedAt":"%s","completedAt":"%s"}' \
      "$separator" "$name" "$status" "$entry" "$repo" "$row" "$STARTED" "$completed"
    separator=","
  done <"$rows" 2>/dev/null || true
  printf ']'
}

verdict() {
  local name status conclusion required total settled red context rows="${1:-$CHECKS}"
  total=0; settled=0; red=0
  while IFS='|' read -r name status conclusion required kind; do
    [ -n "$name" ] || continue
    [ "$required" = "true" ] || continue
    total=$((total + 1))
    [ "$status" = "completed" ] || continue
    settled=$((settled + 1))
    case "$conclusion" in
      success|skipped|neutral) ;;
      *) red=1 ;;
    esac
  done <"$rows" 2>/dev/null || true
  if [ "$red" = "1" ]; then printf 'red'; return; fi
  # A context classic branch protection requires holds the merge until a run of it
  # has passed, whether or not anything has reported one — GitHub merges nothing past
  # a required check that never started.
  if [ -f "$STATE/classic-protection" ]; then
    while IFS= read -r context; do
      [ -n "$context" ] || continue
      grep -q "^$context|completed|\(success\|skipped\|neutral\)|" "$rows" 2>/dev/null \
        || { printf 'pending'; return; }
    done <"$STATE/classic-protection"
  fi
  if [ "$total" -gt 0 ] && [ "$total" = "$settled" ]; then printf 'green'
  else printf 'pending'; fi
}

# One value as a JSON string, escaped the way `gh` prints its `--json` fields: a
# change request's title and body are the two answers here that are prose rather
# than this host's own words, and a body carries newlines and quotes.
json_string() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  printf '"%s"' "$s"
}

# What one change request's record holds as its title or its body, as a JSON string,
# with the one newline `printf '%s\n'` wrote after it taken back off — exactly one,
# so a body that ends in a blank line still reads as one. Read and encoded in one
# function, because a command substitution between the two would strip the trailing
# newlines the body really carries.
json_recorded() {
  local text
  text="$(cat "$1"; printf x)"
  text="${text%x}"
  json_string "${text%$'\n'}"
}

# The issues change request `$1` closes, as GitHub's `closingIssuesReferences` answers
# them: one node per line of `closes-<n>`, each `owner/name#number`, in the order the
# record lists them, and a line `?` a node naming no repository or number — an answer
# no issue can be read out of. A change request with no such record closes none.
closing_references() {
  local record="$STATE/closes-$1" line owner name number separator=""
  printf '['
  if [ -f "$record" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      if [ "$line" = "?" ]; then
        printf '%s{"id":"I_unreadable"}' "$separator"; separator=","; continue
      fi
      owner="${line%%/*}"; name="${line#*/}"; name="${name%%#*}"; number="${line##*#}"
      printf '%s{"id":"I_%s_%s_%s","number":%s,"repository":{"id":"R_%s_%s","name":"%s","owner":{"id":"U_%s","login":"%s"}},"url":"https://github.com/%s/%s/issues/%s"}' \
        "$separator" "$owner" "$name" "$number" "$number" "$owner" "$name" "$name" "$owner" "$owner" "$owner" "$name" "$number"
      separator=","
    done <"$record"
  fi
  printf ']'
}

# Perform the merge of one change request, with real git against the real bare
# origin, and record it as merged.
land_pr() {
  . "$STATE/pr-$1.env"
  work="$STATE/merge-$PR_NUMBER"
  rm -rf "$work"
  git clone -q "$ORIGIN" "$work"
  git -C "$work" checkout -q "$PR_BASE"
  git -C "$work" merge -q --squash "origin/$PR_HEAD"
  git -C "$work" commit -q -m "$(cat "$STATE/pr-$PR_NUMBER.title") (#$PR_NUMBER)"
  git -C "$work" push -q origin "$PR_BASE"
  oid="$(git -C "$work" rev-parse HEAD)"
  {
    printf 'PR_NUMBER=%s\n' "$PR_NUMBER"
    printf 'PR_URL=%s\n' "$PR_URL"
    printf 'PR_STATE=MERGED\n'
    printf 'PR_HEAD=%q\n' "$PR_HEAD"
    printf 'PR_BASE=%q\n' "$PR_BASE"
    printf 'PR_HEAD_SHA=%s\n' "$PR_HEAD_SHA"
    printf 'PR_MERGE_COMMIT=%s\n' "$oid"
    # When GitHub says the change merged, on GitHub's clock: the moment it landed,
    # which a read that reconciles the landing later must report rather than its own.
    # A world may set that clock, so a journey can tell GitHub's time from its own,
    # or have the host record no time at all, which it then answers as null.
    if [ -f "$STATE/no-merge-time" ]; then
      :
    elif [ -f "$STATE/merge-clock" ]; then
      printf 'PR_MERGED_AT=%s\n' "$(cat "$STATE/merge-clock")"
    else
      printf 'PR_MERGED_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fi
  } >"$STATE/pr-$PR_NUMBER.env"
  rm -rf "$work"
}

# Whether change request `$1` may merge as far as being up to date goes: a world whose
# protection requires an up-to-date branch merges only a head that carries its base's
# tip, as GitHub's `strict` does, and every other world merges any head.
up_to_date() {
  [ -n "$UP_TO_DATE" ] || return 0
  local base_tip head_tip
  base_tip="$( . "$STATE/pr-$1.env"; git --git-dir "$ORIGIN" rev-parse "refs/heads/$PR_BASE" )"
  head_tip="$( . "$STATE/pr-$1.env"; git --git-dir "$ORIGIN" rev-parse "refs/heads/$PR_HEAD" )"
  git --git-dir "$ORIGIN" merge-base --is-ancestor "$base_tip" "$head_tip"
}

# The rows the verdict on change request `$1` is reached from: its head's own, where a
# journey seeded them, as its rollup is rendered.
rows_of_change() {
  rows_for "$( . "$STATE/pr-$1.env"; head_seen "$PR_HEAD_SHA" "$PR_HEAD" )"
}

# GitHub's native auto-merge, on GitHub's own clock: a change this host was asked to
# hold lands the moment its required checks go green, whether or not anybody asks it
# to again. Every call is such a moment, which is what lets a publication that is
# watching the change observe the landing without a second process driving it.
settle_auto_merges() {
  local armed pr
  for armed in "$STATE"/auto-*; do
    [ -e "$armed" ] || continue
    pr="${armed##*/auto-}"
    [ -f "$STATE/pr-$pr.env" ] || continue
    [ ! -f "$STATE/closed-$pr" ] || continue
    [ ! -f "$STATE/refuse-merge" ] || continue
    [ "$(verdict "$(rows_of_change "$pr")")" = "green" ] || continue
    up_to_date "$pr" || continue
    # GitHub lands only a change it can merge: one that conflicts with its base, or
    # whose mergeability it has not computed yet, stays held however green it is.
    [ "$(mergeability_now | cut -d' ' -f1)" = "MERGEABLE" ] || continue
    ( . "$STATE/pr-$pr.env"; [ "$PR_STATE" = "OPEN" ] ) || continue
    # Silenced, because this runs *inside* whatever call happened to be the moment
    # the host landed it: `git merge --squash` prints a line even under `-q`, and on
    # a `pr view --json` call that line would arrive ahead of the JSON.
    ( land_pr "$pr" ) >/dev/null
  done
}
# On the calls that *observe* the change request, never on the one that arms the
# hold: GitHub lands a held change between calls, and landing it during the very
# call that asked it to hold would leave that call merging something already merged.
case "$subcommand" in
  view|checks|list|rest) settle_auto_merges ;;
esac

case "$subcommand" in
  checks)
    # Where `gh` reports whether a check blocks the merge, and where each check
    # ran. `gh pr view`'s rollup says neither, which is why this is a second call.
    . "$STATE/pr-$number.env"
    CHECKS="$(rows_for "$PR_HEAD_SHA")"
    # It resolves the same check runs the rollup does, so a credential refused
    # there is refused here — this command is not a second way in.
    readable_rollup || refused_graphql
    if [ -f "$STATE/no-checks-yet" ]; then
      # What `gh` says about a head nothing has reported on yet, on every form of
      # this call — deliberately one word away from the "no required checks" wording
      # further down, which says the opposite: that the repository requires none.
      printf "no checks reported on the '%s' branch\n" "$PR_HEAD" >&2
      exit 1
    fi
    if [ "$only_required" = "0" ]; then
      case "$malformed" in
        no-check-list)
          printf 'the host will not list the checks on this change request\n' >&2
          exit 1 ;;
        no-job)
          # It reported the check and will not say where it ran.
          printf '[]\n'
          exit 0 ;;
        jobless-link)
          printf '[{"name":"%s","state":"COMPLETED","link":"https://github.com/%s/actions/runs/1"}]\n' \
            "$(awk -F'|' 'NF { print $1; exit }' "$CHECKS")" "$repo"
          exit 0 ;;
        non-list)
          # Well-formed JSON that is not a list of checks: an answer nothing can be
          # searched for a job, as distinct from one that lists no job.
          printf '{"checks":[]}\n'
          exit 0 ;;
      esac
    fi
    if [ "$only_required" = "1" ] && [ -f "$STATE/partial-checks" ]; then
      # A host that will not say which of its checks block the merge. Deliberately
      # not the "no required checks" wording, which means the opposite: that the
      # repository requires none and the host knows it.
      printf 'the host declines to say which of its checks block the merge\n' >&2
      exit 1
    fi
    rows=""; separator=""; row=0; unsettled=0
    while IFS='|' read -r name status conclusion required kind; do
      [ -n "$name" ] || continue
      # Counted over every row, filtered or not, so the job id a row reports is the
      # one `gh run view --job` answers to.
      row=$((row + 1))
      if [ "$only_required" = "1" ] && [ "$required" != "true" ]; then continue; fi
      [ "$status" = "completed" ] || unsettled=1
      # A commit status is where its integration said it is, which names no job.
      link="https://github.com/$repo/actions/runs/1/job/$row"
      [ "$kind" != "status" ] || link="https://ci.example.com/$repo/$row"
      rows="$rows$separator{\"name\":\"$name\",\"state\":\"$status\",\"link\":\"$link\"}"
      separator=","
    done <"$CHECKS" 2>/dev/null || true
    if [ "$only_required" = "1" ] && [ -z "$rows" ]; then
      printf "no required checks reported on the '%s' branch\n" "$PR_HEAD" >&2
      exit 1
    fi
    printf '[%s]\n' "$rows"
    # gh reports a non-zero status when a check it has just printed has not
    # settled. The rollup above is still the answer, and a caller that read this
    # as a failure would be unable to watch a check at all.
    [ "$unsettled" = "0" ] || exit 8
    exit 0
    ;;
  list)
    printf '['
    separator=""
    for record in "$STATE"/pr-*.env; do
      [ -e "$record" ] || continue
      . "$record"
      [ "$PR_STATE" = "OPEN" ] || continue
      # Somebody closed it without merging it, which is a thing that happens to a
      # change request and leaves the branch exactly where it was.
      [ ! -f "$STATE/closed-$PR_NUMBER" ] || continue
      [ "$PR_HEAD" = "$head" ] || continue
      [ "$PR_BASE" = "$base" ] || continue
      PR_HEAD_SHA="$(head_seen "$PR_HEAD_SHA" "$PR_HEAD")"
      case "$malformed" in
        no-number)
          printf '%s{"url":"%s","state":"%s","headRefOid":"%s"}' \
            "$separator" "$PR_URL" "$PR_STATE" "$PR_HEAD_SHA"
          separator=","
          continue ;;
        no-head)
          printf '%s{"number":%s,"url":"%s","state":"%s"}' \
            "$separator" "$PR_NUMBER" "$PR_URL" "$PR_STATE"
          separator=","
          continue ;;
      esac
      printf '%s{"number":%s,"url":"%s","state":"%s","headRefOid":"%s"' \
        "$separator" "$PR_NUMBER" "$PR_URL" "$PR_STATE" "$PR_HEAD_SHA"
      # The draft state and the description, where the listing asked for them — as
      # `gh` answers exactly the fields it was asked for, and as `view` below answers
      # them, the malformed answers that leave one out included.
      listed() { case ",$json_fields," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
      if listed isDraft && [ "$malformed" != "no-draft-state" ]; then
        listed_draft=false
        if [ "${PR_DRAFT:-0}" = "1" ] && [ ! -f "$STATE/ready-$PR_NUMBER" ]; then listed_draft=true; fi
        printf ',"isDraft":%s' "$listed_draft"
      fi
      if listed title && [ -f "$STATE/pr-$PR_NUMBER.title" ]; then
        printf ',"title":%s' "$(json_recorded "$STATE/pr-$PR_NUMBER.title")"
      fi
      if listed body && [ -f "$STATE/pr-$PR_NUMBER.body" ] && [ "$malformed" != "no-description" ]; then
        printf ',"body":%s' "$(json_recorded "$STATE/pr-$PR_NUMBER.body")"
      fi
      printf '}'
      separator=","
    done
    printf ']\n'
    ;;
  rest)
    # GitHub's REST API about change requests and the checks on a commit, answered from
    # the records `gh pr create` wrote and the rows the rollup is rendered from — so the
    # two transports cannot come to disagree about one host. Asked `--include`, the
    # status line and GitHub's rate-limit headers come first, as `gh` prints them.
    include=false
    for argument in "${ARGUMENTS[@]}"; do [ "$argument" = "--include" ] && include=true; done
    rest_query=""
    case "${ARGUMENTS[1]}" in *\?*) rest_query="${ARGUMENTS[1]#*\?}" ;; esac
    slug="${rest_call#repos/}"; slug="$(printf '%s' "$slug" | cut -d/ -f1-2)"
    answered() {
      if [ "$include" = true ]; then
        printf 'HTTP/2.0 200 OK\nContent-Type: application/json; charset=utf-8\nX-Ratelimit-Limit: 5000\nX-Ratelimit-Remaining: 4999\nX-Ratelimit-Resource: core\n\n'
      fi
      printf '%s\n' "$1"
      exit 0
    }
    # What GitHub answers a credential the repository does not let read its check runs
    # or commit statuses: a 403, which says nothing about whether there are any.
    forbidden() {
      [ "$include" = false ] || printf 'HTTP/2.0 403 Forbidden\nContent-Type: application/json; charset=utf-8\n\n'
      printf '{"message":"Resource not accessible by personal access token","status":"403"}\n'
      printf 'gh: Resource not accessible by personal access token (HTTP 403)\n' >&2
      exit 1
    }
    # One query parameter's value, decoded as a URL query decodes it.
    query_value() {
      local pair value=""
      for pair in ${rest_query//&/ }; do
        case "$pair" in "$1="*) value="${pair#*=}" ;; esac
      done
      value="${value//+/ }"
      printf '%b' "${value//%/\\x}"
    }
    # One change request's record as GitHub's REST API describes a pull request, with
    # the head this host has noticed — as the reading about to be made where `$2` says
    # so — and the malformed answers that leave a field out.
    pull_json() {
      local record="$1" ahead="${2:-0}" head_sha state merged merged_at merge_commit draft mergeable merge_state
      (
        . "$record"
        head_sha="$(head_seen "$PR_HEAD_SHA" "$PR_HEAD" "$ahead")"
        state=open; merged=false
        case "$PR_STATE" in MERGED) state=closed; merged=true ;; CLOSED) state=closed ;; esac
        if [ -f "$STATE/closed-$PR_NUMBER" ] && [ "$PR_STATE" = "OPEN" ]; then state=closed; fi
        merged_at=null; [ -z "${PR_MERGED_AT:-}" ] || merged_at="\"$PR_MERGED_AT\""
        merge_commit=null; [ -z "$PR_MERGE_COMMIT" ] || merge_commit="\"$PR_MERGE_COMMIT\""
        draft=false
        if [ "${PR_DRAFT:-0}" = "1" ] && [ ! -f "$STATE/ready-$PR_NUMBER" ]; then draft=true; fi
        # GitHub's REST API answers `true`, `false`, or `null` while it has not computed
        # it; a world that states some other word is a host answering in a shape it
        # never answers in, which is passed through as that word.
        case "$(mergeability_now | cut -d' ' -f1)" in
          MERGEABLE) mergeable=true ;;
          CONFLICTING) mergeable=false ;;
          UNKNOWN) mergeable=null ;;
          *) mergeable="\"$(mergeability_now | cut -d' ' -f1)\"" ;;
        esac
        merge_state="$(mergeability_now | cut -d' ' -f2 | tr '[:upper:]' '[:lower:]')"
        printf '{'
        [ "$malformed" = "no-number" ] || printf '"number":%s,' "$PR_NUMBER"
        printf '"html_url":"%s","url":"https://api.github.com/repos/%s/pulls/%s","state":"%s","merged":%s,"merged_at":%s,"merge_commit_sha":%s' \
          "$PR_URL" "$slug" "$PR_NUMBER" "$state" "$merged" "$merged_at" "$merge_commit"
        if [ "$malformed" != "no-head" ]; then
          printf ',"head":{"ref":%s,"sha":"%s"}' "$(json_string "$PR_HEAD")" "$head_sha"
        fi
        printf ',"base":{"ref":%s}' "$(json_string "$PR_BASE")"
        [ "$malformed" = "no-draft-state" ] || printf ',"draft":%s' "$draft"
        if [ -f "$STATE/pr-$PR_NUMBER.title" ]; then
          printf ',"title":%s' "$(json_recorded "$STATE/pr-$PR_NUMBER.title")"
        fi
        if [ "$malformed" != "no-description" ] && [ -f "$STATE/pr-$PR_NUMBER.body" ]; then
          printf ',"body":%s' "$(json_recorded "$STATE/pr-$PR_NUMBER.body")"
        fi
        [ "$malformed" = "no-mergeable" ] || printf ',"mergeable":%s' "$mergeable"
        printf ',"mergeable_state":"%s"}' "$merge_state"
      )
    }
    case "$rest_call" in
      */pulls)
        # GitHub's "List pull requests": `head` names the branch as `<owner>:<branch>`,
        # and only the open ones are asked for.
        wanted_head="$(query_value head)"; wanted_head="${wanted_head#*:}"
        wanted_base="$(query_value base)"
        items=""; separator=""
        for record in "$STATE"/pr-*.env; do
          [ -e "$record" ] || continue
          ( . "$record"
            [ "$PR_STATE" = "OPEN" ] || exit 1
            # Somebody closed it without merging it, which is a thing that happens to a
            # change request and leaves the branch exactly where it was.
            [ ! -f "$STATE/closed-$PR_NUMBER" ] || exit 1
            [ "$PR_HEAD" = "$wanted_head" ] || exit 1
            [ -z "$wanted_base" ] || [ "$PR_BASE" = "$wanted_base" ] ) || continue
          items="$items$separator$(pull_json "$record")"
          separator=","
        done
        answered "[$items]" ;;
      */pulls/*)
        number="${rest_call##*/pulls/}"
        if [ ! -f "$STATE/pr-$number.env" ]; then
          [ "$include" = false ] || printf 'HTTP/2.0 404 Not Found\nContent-Type: application/json; charset=utf-8\n\n'
          printf '{"message":"Not Found","status":"404"}\n'
          printf 'gh: Not Found (HTTP 404)\n' >&2
          exit 1
        fi
        answered "$(pull_json "$STATE/pr-$number.env" 1)" ;;
      */check-runs)
        sha="${rest_call%/check-runs}"; sha="${sha##*/}"
        if [ "$malformed" = "misleading-refusal" ]; then
          # A failure that merely mentions the wording of a refusal: not this credential
          # being refused, and not to be answered from somewhere narrower.
          [ "$include" = false ] || printf 'HTTP/2.0 422 Unprocessable Entity\nContent-Type: application/json; charset=utf-8\n\n'
          printf 'gh: another field said Resource not accessible while the checks service was unavailable (HTTP 422)\n' >&2
          exit 1
        fi
        readable_rollup || forbidden
        if [ "$malformed" = "rollup-not-a-list" ]; then answered '{"total_count":1,"check_runs":"soon"}'; fi
        # A page that holds entries back says how many there are.
        if [ "$malformed" = "checks-truncated" ]; then answered '{"total_count":101,"check_runs":[]}'; fi
        rows="$(rows_for "$sha")"
        only="$(query_value check_name)"
        # A lookup of one check's job, which is where a host that will not say where a
        # check ran says so.
        if [ -n "$only" ]; then
          case "$malformed" in
            no-check-list)
              [ "$include" = false ] || printf 'HTTP/2.0 422 Unprocessable Entity\nContent-Type: application/json; charset=utf-8\n\n'
              printf 'gh: the host will not list the checks on this commit (HTTP 422)\n' >&2
              exit 1 ;;
            non-list)
              answered '{"total_count":0,"check_runs":{"soon":true}}' ;;
          esac
        fi
        # A host whose check runs say they ran against something that is not a commit
        # hash: the commit a check is attached to is read off this field, so this is
        # where that answer arrives malformed on the REST path.
        run_head="$sha"
        if [ "$malformed" = "head-not-a-commit" ]; then run_head="the tip of the branch"; fi
        runs=""; separator=""; row=0; total=0
        while IFS='|' read -r name status conclusion required kind; do
          [ -n "$name" ] || continue
          # Counted over every row, so the job id a row reports is the one `gh run view
          # --job` answers to.
          row=$((row + 1))
          [ "$kind" != "status" ] || continue
          [ -z "$only" ] || [ "$name" = "$only" ] || continue
          if [ -n "$conclusion" ]; then entry="\"$conclusion\""; else entry=null; fi
          if [ "$status" = "completed" ]; then completed="\"${STARTED%:00Z}:30Z\""; else completed=null; fi
          details=",\"details_url\":\"https://github.com/$slug/actions/runs/1/job/$row\""
          if [ -n "$only" ]; then
            case "$malformed" in
              no-job) details="" ;;
              jobless-link) details=",\"details_url\":\"https://github.com/$slug/actions/runs/1\"" ;;
            esac
          fi
          runs="$runs$separator{\"id\":$row,\"name\":\"$name\",\"head_sha\":\"$run_head\",\"status\":\"$status\",\"conclusion\":$entry$details,\"html_url\":\"https://github.com/$slug/runs/$row\",\"started_at\":\"$STARTED\",\"completed_at\":$completed}"
          separator=","
          total=$((total + 1))
        done <"$rows" 2>/dev/null || true
        answered "{\"total_count\":$total,\"check_runs\":[$runs]}" ;;
      */status)
        # GitHub's combined status of a commit: one entry per context an integration
        # posted, its `state` pending until it has a verdict.
        sha="${rest_call%/status}"; sha="${sha##*/}"
        readable_rollup || forbidden
        if [ "$malformed" = "statuses-truncated" ]; then
          answered "{\"state\":\"pending\",\"sha\":\"$sha\",\"total_count\":101,\"statuses\":[]}"
        fi
        rows="$(rows_for "$sha")"
        statuses=""; separator=""; row=0; total=0
        while IFS='|' read -r name status conclusion required kind; do
          [ -n "$name" ] || continue
          row=$((row + 1))
          [ "$kind" = "status" ] || continue
          if [ "$status" = "completed" ]; then state="$conclusion"; else state=pending; fi
          statuses="$statuses$separator{\"context\":\"$name\",\"state\":\"$state\",\"target_url\":\"https://ci.example.com/$slug/$row\",\"created_at\":\"$STARTED\",\"updated_at\":\"$STARTED\"}"
          separator=","
          total=$((total + 1))
        done <"$rows" 2>/dev/null || true
        answered "{\"state\":\"pending\",\"sha\":\"$sha\",\"total_count\":$total,\"statuses\":[$statuses]}" ;;
    esac
    printf 'fake gh: unsupported REST read %s\n' "$rest_call" >&2
    exit 1
    ;;
  create)
    case "$malformed" in
      no-url)
        printf 'created something, somewhere\n'
        exit 0 ;;
      url-names-no-change)
        printf 'https://github.com/%s/pulls\n' "$repo"
        exit 0 ;;
    esac
    next=1
    while [ -f "$STATE/pr-$next.env" ]; do next=$((next + 1)); done
    head_sha="$(git --git-dir "$ORIGIN" rev-parse "refs/heads/$head" 2>/dev/null || printf 'unknown')"
    {
      printf 'PR_NUMBER=%s\n' "$next"
      printf 'PR_URL=https://github.com/%s/pull/%s\n' "$repo" "$next"
      printf 'PR_STATE=OPEN\n'
      # %q, because git lets a branch name carry a quote and this record is sourced.
      printf 'PR_HEAD=%q\n' "$head"
      printf 'PR_BASE=%q\n' "$base"
      printf 'PR_HEAD_SHA=%s\n' "$head_sha"
      printf 'PR_MERGE_COMMIT=\n'
      printf 'PR_DRAFT=%s\n' "$draft"
    } >"$STATE/pr-$next.env"
    printf '%s\n' "$title" >"$STATE/pr-$next.title"
    printf '%s\n' "$body" >"$STATE/pr-$next.body"
    printf 'https://github.com/%s/pull/%s\n' "$repo" "$next"
    ;;
  view)
    . "$STATE/pr-$number.env"
    PR_HEAD_SHA="$(head_seen "$PR_HEAD_SHA" "$PR_HEAD")"
    CHECKS="$(rows_for "$PR_HEAD_SHA")"
    # A host that answers with a head that is not a commit hash at all. The rollup
    # is rendered from this same field, so what a check is attached to arrives
    # malformed here and nowhere else on that path.
    if [ "$malformed" = "head-not-a-commit" ]; then PR_HEAD_SHA="the tip of the branch"; fi
    if [ -f "$STATE/closed-$number" ]; then PR_STATE=CLOSED; fi
    # `gh` returns exactly the fields it was asked for, and so does this: a caller
    # that reads a field out of an answer it never requested is a caller that works
    # here and fails against the real host.
    wanted() { case ",$json_fields," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
    merge_commit=null
    if [ -n "$PR_MERGE_COMMIT" ]; then merge_commit="{\"oid\":\"$PR_MERGE_COMMIT\"}"; fi
    # Whether the host holds it as a draft: opened as one and not made ready since,
    # which is what makes lifting it observable and lifting it twice a no-op. Every
    # shape of answer below reports it, the malformed ones included.
    is_draft=false
    if [ "${PR_DRAFT:-0}" = "1" ] && [ ! -f "$STATE/ready-$PR_NUMBER" ]; then is_draft=true; fi
    case "$malformed" in
      no-head)
        printf '{"number":%s,"state":"%s","isDraft":%s,"mergeCommit":null,"statusCheckRollup":[]}\n' \
          "$PR_NUMBER" "$PR_STATE" "$is_draft"
        exit 0 ;;
      rollup-not-a-list)
        printf '{"number":%s,"state":"%s","headRefOid":"%s","isDraft":%s,"mergeCommit":null,"statusCheckRollup":"soon"}\n' \
          "$PR_NUMBER" "$PR_STATE" "$PR_HEAD_SHA" "$is_draft"
        exit 0 ;;
      no-state)
        # Its checks are answered as usual, so the publication reaches the merge —
        # which is the call that has to know whether the change is already merged.
        printf '{"number":%s,"headRefOid":"%s","isDraft":%s,"mergeCommit":null,"statusCheckRollup":%s}\n' \
          "$PR_NUMBER" "$PR_HEAD_SHA" "$is_draft" "$(rollup)"
        exit 0 ;;
      misleading-refusal)
        if wanted statusCheckRollup; then
          printf 'GraphQL: another field said Resource not accessible while the checks service was unavailable\n' >&2
          exit 1
        fi
        ;;
      checks-refused|actions-only*)
        # What real GitHub answers a credential the repository does not allow to read
        # its checks: `gh pr view` fails *whole*, however much of what it was asked
        # for the token could see. Every other field list is answered as usual, which
        # is the point — a caller that asked only for what it reads is unaffected.
        if wanted statusCheckRollup; then
          refused_graphql
        fi
        ;;
    esac
    # A read of the issues a change request closes that is refused, as
    # `refuse-closing-references` says: `permission` (or nothing) — GitHub refuses a
    # credential that may not see them the whole call, naming the field; `unknown-field`
    # — a `gh` that predates the field rejects it while parsing its arguments;
    # `unrelated` — the call fails for a reason naming nothing of the field; and
    # `fallback-too` — refused naming the field, and the same read without it fails too.
    if [ -f "$STATE/refuse-closing-references" ]; then
      refusal="$(cat "$STATE/refuse-closing-references")"
      if wanted closingIssuesReferences; then
        case "$refusal" in
          unknown-field)
            printf 'Unknown JSON field: "closingIssuesReferences"\nAvailable fields:\n  state\n  mergeCommit\n' >&2 ;;
          unrelated)
            printf 'GraphQL: Something went wrong while executing your query.\n' >&2 ;;
          *)
            printf 'GraphQL: Resource not accessible by personal access token (repository.pullRequest.closingIssuesReferences)\n' >&2 ;;
        esac
        exit 1
      fi
      if [ "$refusal" = "fallback-too" ] && wanted mergeCommit; then
        printf 'GraphQL: Something went wrong while executing your query.\n' >&2
        exit 1
      fi
    fi
    separator=""
    printf '{'
    if wanted number; then printf '%s"number":%s' "$separator" "$PR_NUMBER"; separator=","; fi
    if wanted state; then printf '%s"state":"%s"' "$separator" "$PR_STATE"; separator=","; fi
    # A host that will not say whether the change can merge, which is neither answer.
    if wanted mergeable && [ "$malformed" != "no-mergeable" ]; then
      printf '%s"mergeable":"%s"' "$separator" "$(mergeability_now | cut -d' ' -f1)"; separator=","
    fi
    if wanted mergeStateStatus; then
      printf '%s"mergeStateStatus":"%s"' "$separator" "$(mergeability_now | cut -d' ' -f2)"; separator=","
    fi
    if wanted headRefOid; then printf '%s"headRefOid":"%s"' "$separator" "$PR_HEAD_SHA"; separator=","; fi
    # A host that answers the call and says nothing about the draft state, which is
    # not the same as saying it is not one: whether the change may be asked to merge
    # rests on this field, so its absence is a refusal rather than a `false`.
    if wanted isDraft && [ "$malformed" != "no-draft-state" ]; then
      printf '%s"isDraft":%s' "$separator" "$is_draft"; separator=","
    fi
    if wanted mergeCommit; then printf '%s"mergeCommit":%s' "$separator" "$merge_commit"; separator=","; fi
    # Null until it merges, as GitHub answers it. A world may make the host refuse
    # the read outright, which a caller cannot tell from a host that has no answer.
    if wanted mergedAt && [ -f "$STATE/refuse-merge-time" ]; then
      printf 'GraphQL: Resource not accessible by personal access token (repository.pullRequest.mergedAt)\n' >&2
      exit 1
    fi
    if wanted mergedAt; then
      if [ -n "${PR_MERGED_AT:-}" ]; then
        printf '%s"mergedAt":"%s"' "$separator" "$PR_MERGED_AT"
      else
        printf '%s"mergedAt":null' "$separator"
      fi
      separator=","
    fi
    # The description, as `gh pr edit` last left it or `gh pr create` opened it.
    if wanted title; then printf '%s"title":%s' "$separator" "$(json_recorded "$STATE/pr-$number.title")"; separator=","; fi
    if wanted body && [ "$malformed" != "no-description" ]; then printf '%s"body":%s' "$separator" "$(json_recorded "$STATE/pr-$number.body")"; separator=","; fi
    # The record's first line may instead say how the answer is malformed: `!missing`
    # leaves the field out though it was asked for, and `!not-a-list` answers it as a
    # string.
    if wanted closingIssuesReferences; then
      case "$(head -n 1 "$STATE/closes-$number" 2>/dev/null || true)" in
        '!missing') ;;
        '!not-a-list') printf '%s"closingIssuesReferences":"soon"' "$separator"; separator="," ;;
        *) printf '%s"closingIssuesReferences":%s' "$separator" "$(closing_references "$number")"; separator="," ;;
      esac
    fi
    if wanted statusCheckRollup; then printf '%s"statusCheckRollup":%s' "$separator" "$(rollup)"; fi
    printf '}\n'
    ;;
  edit)
    # `gh pr edit`: the body arrives as a file, because a body is prose that does not
    # survive an argument vector, and the title only when the call replaces it. Both
    # land in the same records `pr create` wrote, so `pr view` answers the description
    # as it now stands whichever call wrote it.
    . "$STATE/pr-$number.env"
    if [ -f "$STATE/refuse-edit" ]; then
      printf 'the host declines to edit %s\n' "$PR_URL" >&2
      exit 1
    fi
    if [ -n "$body_file" ]; then
      if [ ! -f "$body_file" ]; then
        printf 'could not read body file %s\n' "$body_file" >&2
        exit 1
      fi
      { cat "$body_file"; printf '\n'; } >"$STATE/pr-$number.body"
    fi
    if [ "$titled" = "1" ]; then printf '%s\n' "$title" >"$STATE/pr-$number.title"; fi
    # `--base` retargets the change request, as `gh pr edit --base` does: the record
    # is rewritten whole with the new base, and everything else it held kept.
    if [ -n "$base" ]; then
      # GitHub retargets only onto a branch the repository has, and says so otherwise.
      if ! git --git-dir "$ORIGIN" rev-parse --verify --quiet "refs/heads/$base" >/dev/null; then
        printf 'could not change the base of %s: %s is not a branch of this repository\n' "$PR_URL" "$base" >&2
        exit 1
      fi
      grep -v '^PR_BASE=' "$STATE/pr-$number.env" >"$STATE/pr-$number.env.next"
      printf 'PR_BASE=%q\n' "$base" >>"$STATE/pr-$number.env.next"
      mv "$STATE/pr-$number.env.next" "$STATE/pr-$number.env"
    fi
    printf '%s\n' "$PR_URL"
    ;;
  ready)
    . "$STATE/pr-$number.env"
    if [ -f "$STATE/refuse-ready" ]; then
      # A host that will not take the change out of its draft: the credential may
      # not, or the host is having a bad day. Nothing is lifted.
      printf 'the host declines to make %s ready for review\n' "$PR_URL" >&2
      exit 1
    fi
    : >"$STATE/ready-$PR_NUMBER"
    printf '%s is marked as "ready for review"\n' "$PR_URL"
    ;;
  merge)
    . "$STATE/pr-$number.env"
    # GitHub will neither merge a draft nor enable auto-merge on one, and says so.
    if [ "${PR_DRAFT:-0}" = "1" ] && [ ! -f "$STATE/ready-$PR_NUMBER" ]; then
      printf 'GraphQL: Pull Request is still a draft (mergePullRequest)\n' >&2
      exit 1
    fi
    if [ "$auto" = "1" ] && [ -f "$STATE/auto-merge-unavailable" ]; then
      printf 'Auto-merge is not enabled for this repository\n' >&2
      exit 1
    fi
    if [ "$auto" = "1" ] && { [ "$(verdict "$(rows_of_change "$PR_NUMBER")")" != "green" ] \
      || ! up_to_date "$PR_NUMBER" \
      || [ "$(mergeability_now | cut -d' ' -f1)" != "MERGEABLE" ]; }; then
      # Native auto-merge: the host holds the change and lands it when its own
      # required checks pass. Nothing merges now, and the hold is recorded so a
      # later call can land it the way GitHub would.
      : >"$STATE/auto-$PR_NUMBER"
      exit 0
    fi
    if ! up_to_date "$PR_NUMBER"; then
      printf 'GraphQL: Head branch is out of date. Review and try the merge again. (mergePullRequest)\n' >&2
      exit 1
    fi
    if [ -f "$STATE/refuse-merge" ]; then
      # Accepted, and then nothing happens — the shape a caller cannot tell from a
      # merge that worked without asking the host again.
      exit 0
    fi
    ( land_pr "$PR_NUMBER" ) >/dev/null
    ;;
  *)
    printf 'fake gh: unsupported pr subcommand %s\n' "$subcommand" >&2
    exit 1
    ;;
esac

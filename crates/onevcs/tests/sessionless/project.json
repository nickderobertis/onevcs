{
  "name": "onevcs-sessionless-e2e",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "onevcs"
  ],
  "//": "llmlint: ignore[new_command_or_client_gets_its_own_project] This task extends the existing onevcs CLI and its existing GitHub client; it adds no executable or independent production deliverable. Only the new journeys need their own cache edge, which this project supplies. Moving those existing production components into a new project would violate the agreed task scope.",
  "targets": {
    "test": {
      "command": "just _sessionless-test",
      "inputs": [
        "{workspaceRoot}/crates/onevcs/src/**/*",
        "{projectRoot}/**/*",
        "{workspaceRoot}/crates/onevcs/Cargo.toml",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/.cargo/config.toml",
        "sharedGlobals",
        "{workspaceRoot}/scripts/coverage.sh",
        "{workspaceRoot}/docs/contract.md"
      ],
      "outputs": [
        "{workspaceRoot}/target/coverage/onevcs-sessionless-e2e.profdata"
      ]
    },
    "test-quick": {
      "command": "just _sessionless-test-quick",
      "inputs": [
        "{workspaceRoot}/crates/onevcs/src/**/*",
        "{projectRoot}/**/*",
        "{workspaceRoot}/crates/onevcs/Cargo.toml",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/.cargo/config.toml",
        "sharedGlobals",
        "{workspaceRoot}/docs/contract.md"
      ]
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": [
        "test"
      ]
    }
  },
  "tags": [
    "scope:e2e",
    "lang:rust"
  ]
}

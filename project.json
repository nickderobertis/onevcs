{
  "name": "workspace",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:repo"],
  "targets": {
    "lint-llm-diff": {
      "command": "llmlint --diff --diff-base \"$LLMLINT_DIFF_BASE_SHA\"",
      "options": { "cwd": "." }
    },
    "msrv": {
      "command": "just _msrv",
      "cache": false,
      "options": { "cwd": "." }
    },
    "deps-check": {
      "command": "just _deps-check",
      "cache": false,
      "options": { "cwd": "." }
    }
  }
}

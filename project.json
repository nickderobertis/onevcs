{
  "name": "workspace",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:repo"],
  "targets": {
    "bootstrap": {
      "command": "bash scripts/install-hooks.sh",
      "options": { "cwd": "." }
    },
    "lint-llm-diff": {
      "command": "./scripts/llmlint-judge.sh",
      "options": { "cwd": ".", "usePty": false }
    },
    "msrv": {
      "command": "just _msrv",
      "cache": false,
      "options": { "cwd": "." }
    },
    "deps-check": {
      "command": "just _deps-check",
      "cache": false,
      "options": { "cwd": "." }
    }
  }
}
